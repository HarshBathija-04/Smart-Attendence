NODE_ENV=development
PORT=5128
# Shared Postgres; each app keeps its tables in its own schema.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio
DB_SCHEMA=smart_attendance
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5214
FACE_SERVICE_URL=http://localhost:5129
# Must match FACE_SERVICE_TOKEN on the face service (leave empty locally to disable)
FACE_SERVICE_TOKEN=
FACE_MATCH_THRESHOLD=0.363
APP_TIMEZONE=Asia/Kolkata
# Groq powers the optional AI report insights
GROQ_API_KEY=your-groq-api-key
SEED_DEMO_DATA=true
DEMO_PASSWORD=demo1234
