{
  "name": "smart-attendance-api",
  "version": "2.0.0",
  "private": true,
  "description": "REST API for Smart Attendance: auth, classes, students, face-based attendance and reports",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "db:setup": "tsx src/migrate.ts && tsx src/seed.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "groq-sdk": "1.6.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
