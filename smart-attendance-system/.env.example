# Smart Attendance Web System - Environment Variables
# ===================================================
# Copy this file to .env and update the values

# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
# For SQLite (default)
DATABASE_URL=sqlite:///database/attendance.db

# For MySQL (optional - uncomment to use)
# DATABASE_URL=mysql://username:password@localhost/smart_attendance

# Face Recognition Configuration
FACE_RECOGNITION_THRESHOLD=0.5
MINIMUM_CONFIDENCE=70

# Upload Configuration
UPLOAD_FOLDER=datasets/registered_faces
MAX_CONTENT_LENGTH=16777216

# JWT Configuration
JWT_EXPIRATION_HOURS=24

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Email Configuration (optional - for notifications)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@smartattendance.com
