# Smart Attendance Web System - Git Ignore
# ========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# Environment Variables
.env
.env.local
.env.*.local

# Database
database/*.db
database/*.sqlite
database/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Uploaded Files
datasets/registered_faces/*
!datasets/registered_faces/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Flask
instance/
.webassets-cache

# Testing
.coverage
htmlcov/
.tox/
.pytest_cache/

# Documentation builds
docs/_build/

# Temporary files
tmp/
temp/
*.tmp

# OS files
Thumbs.db
.DS_Store

# Node (if using any Node tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Keep directory structure
!.gitkeep
